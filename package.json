{
  "name": "anylist-mcp",
  "version": "1.8.0",
  "description": "MCP server for AnyList shopping list integration",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test:client": "node test/anylist-client/index.js",
    "test:integration": "node test/integration.js",
    "pack": "mcpb pack",
    "start:http": "node src/http/index.js",
    "dev:http": "node --watch src/http/index.js",
    "test": "node --test test/*.test.js test/tools/*.test.js",
    "test:http": "node --test test/http/*.test.js",
    "check:submodule-deps": "node scripts/check-submodule-deps.mjs"
  },
  "keywords": [
    "mcp",
    "anylist",
    "shopping",
    "list"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "dotenv": "^16.4.5",
    "form-data": "^3.0.5",
    "got": "^11.8.6",
    "protobufjs": "5.0.3",
    "reconnecting-websocket": "^4.2.0",
    "tough-cookie": "^4.1.3",
    "ws": "^7.5.12",
    "zod": "^3.25.76"
  },
  "optionalDependencies": {
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.8.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.19.0",
    "google-auth-library": "^10.6.2"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "better-sqlite3@12.11.1": true
  }
}
